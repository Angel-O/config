# This is Git's per-user configuration file.
[user]
	name = 
	email = 
[alias]

  ##################################### switch branch
	co = checkout

  ##################################### amend last commit
	amd = commit --amend

  ##################################### nicely log last 10 commits to console
	lg = log -n 10 --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

  ##################################### create empty commit
	empty = commit --allow-empty -m'+semver: minor'

  ##################################### discard current changes
	dsd = checkout -- .

  ##################################### push to origin for the first time, without typing set upstream option
	pusho = "!git push -u origin \"$(git rev-parse --abbrev-ref HEAD)\""

  ##################################### fetch master without changing branch
	fm = "!git fetch origin master:master"

  ##################################### log graph for all branches
	lgr = log --pretty=oneline --graph --decorate --all
	unset = branch --unset-upstream
	fo = "!f() { git fetch origin $1:$1; }; f"
	current = rev-parse --abbrev-ref HEAD
	rename = "!f() { git branch -m $1; }; f"
	repos = "C:\\workspace\\source"
	ignore = "!f() { git update-index --assume-unchanged $1; }; f"
	unignore = "!f() { git update-index --no-assume-unchanged $1; }; f"
	ignored = !git ls-files -v | grep ^[a-z]

  ##################################### shorthand for git worktree
	wt = worktree

  ##################################### list worktrees
	wtl = worktree list

  ##################################### prune stale worktree metadata
	wtp = worktree prune

  ##################################### remove a matching worktree under ../<repo>-worktrees/<branch>
	wtr = "!f() { repo=$(basename \"$(git rev-parse --show-toplevel)\"); git worktree remove \"../${repo}-worktrees/$1\"; }; f"

  ##################################### add a worktree for an existing branch under ../<repo>-worktrees/<branch>
	wtb = "!f() { repo=$(basename \"$(git rev-parse --show-toplevel)\"); git worktree add \"../${repo}-worktrees/$1\" \"$1\"; }; f"

  ##################################### create a new branch and matching worktree under ../<repo>-worktrees/<branch>
	wtbn = "!f() { repo=$(basename \"$(git rev-parse --show-toplevel)\"); git worktree add -b \"$1\" \"../${repo}-worktrees/$1\" \"${2:-origin/main}\"; }; f"
[core]

  ##################################### use notepad++ as default editor
  ##	editor = "\"C:\\Program Files\\Notepad++\\notepad++.exe\" -multiInst -notabbar -nosession -noPlugin %*"

  ##################################### use vs code as default editor
	editor = code -n --wait
[diff]
    tool = default-difftool
[difftool "default-difftool"]
    cmd = code --wait --diff $LOCAL $REMOTE
[merge]
    tool = vscode
[mergetool "vscode"]
    cmd = code -n --wait $MERGED
[credential]
	helper = wincred


