# This is Git's per-user configuration file.
[user]
	name = 
	email = 
[alias]

  ##################################### switch branch
	co = checkout

  ##################################### amend last commit
	amd = commit --amend

  ##################################### nicely log last 10 commits to console
	lg = log -n 10 --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

  ##################################### create empty commit
	empty = commit --allow-empty -m'+semver: minor'

  ##################################### discard current changes
	dsd = checkout -- .

  ##################################### push to origin for the first time, without typing set upstream option
	pusho = "!git push -u origin \"$(git rev-parse --abbrev-ref HEAD)\""

  ##################################### fetch master without changing branch
	fm = "!git fetch origin master:master"

  ##################################### log graph for all branches
	lgr = log --pretty=oneline --graph --decorate --all
	unset = branch --unset-upstream
	fo = "!f() { git fetch origin $1:$1; }; f"
	current = rev-parse --abbrev-ref HEAD
	rename = "!f() { git branch -m $1; }; f"
	repos = "C:\\workspace\\source"
	ignore = "!f() { git update-index --assume-unchanged $1; }; f"
	unignore = "!f() { git update-index --no-assume-unchanged $1; }; f"
	ignored = !git ls-files -v | grep ^[a-z]

  ##################################### shorthand for git worktree
	wt = worktree

  ##################################### list worktrees
	wtl = worktree list

  ##################################### prune stale worktree metadata
	wtp = worktree prune

  ##################################### remove the worktree currently registered for a branch
	wtrm = "!f() { branch=$1; if [ -z \"$branch\" ]; then printf 'usage: git wtrm <branch>\n' >&2; return 1; fi; path=$(git for-each-ref --format='%(worktreepath)' \"refs/heads/$branch\"); if [ -z \"$path\" ]; then printf 'wtrm: no worktree found for branch %s\n' \"$branch\" >&2; return 1; fi; git worktree remove \"$path\"; }; f"

  ##################################### checkout a branch under ~/workspace/worktrees/<repo>/<branch-slug>
	wtco = "!f() { main=$(git worktree list --porcelain | awk '/^worktree / { print substr($0, 10); exit }'); repo=$(basename \"$main\"); if [ \"$1\" = \"-b\" ]; then branch=$2; base=${3:-origin/main}; else branch=$1; fi; if [ -z \"$branch\" ]; then printf 'usage: git wtco [-b] <branch> [base]\n' >&2; return 1; fi; slug=$(printf '%s' \"$branch\" | LC_ALL=C tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'); slug=${slug:-worktree}; path=\"$HOME/workspace/worktrees/$repo/$slug\"; mkdir -p \"$(dirname \"$path\")\" || return; if [ \"$1\" = \"-b\" ]; then git worktree add -b \"$branch\" \"$path\" \"$base\"; elif git show-ref --verify --quiet \"refs/heads/${branch}\"; then git worktree add \"$path\" \"$branch\"; elif git show-ref --verify --quiet \"refs/remotes/origin/${branch}\"; then git worktree add -b \"$branch\" \"$path\" \"origin/$branch\"; else printf 'wtco: branch %s not found locally or in refs/remotes/origin; fetch first if needed\n' \"$branch\" >&2; return 1; fi; }; f"
[core]

  ##################################### use notepad++ as default editor
  ##	editor = "\"C:\\Program Files\\Notepad++\\notepad++.exe\" -multiInst -notabbar -nosession -noPlugin %*"

  ##################################### use vs code as default editor
	editor = code -n --wait
[diff]
    tool = default-difftool
[difftool "default-difftool"]
    cmd = code --wait --diff $LOCAL $REMOTE
[merge]
    tool = vscode
[mergetool "vscode"]
    cmd = code -n --wait $MERGED
[credential]
	helper = wincred


